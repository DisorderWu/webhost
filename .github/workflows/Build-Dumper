name: Build Il2CppDumper v39

# 允许手动点击运行
on: [workflow_dispatch]

jobs:
  build:
    runs-on: windows-latest # 使用云端 Windows 环境编译

    steps:
    # 1. 自动从原作者的 v39 分支拉取代码
    - name: Download Source Code
      uses: actions/checkout@v4
      with:
        repository: 'roytu/Il2CppDumper'
        ref: 'v39'

    # 2. 配置 .NET 6 编译环境
    - name: Setup .NET
      uses: actions/setup-dotnet@v4
      with:
        dotnet-version: '6.0.x'

    # 3. 执行编译命令，生成 Windows 独立运行版本
    - name: Build Dumper
      run: dotnet publish Il2CppDumper/Il2CppDumper.csproj -c Release -r win-x64 -o ./build_output

    # 4. 把编译好的文件打包成 ZIP 供你下载
    - name: Upload Finished Artifact
      uses: actions/upload-artifact@v4
      with:
        name: Il2CppDumper-v39-Win64
        path: ./build_output/
